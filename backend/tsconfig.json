{
  "compilerOptions": {
    "module": "commonjs",
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2021",
    "sourceMap": true,
    "outDir": "./dist",
    "baseUrl": "./",
    "incremental": true,
    "skipLibCheck": true,
    "strict": true,
    "strictNullChecks": true,
    "strictPropertyInitialization": false,
    "noImplicitAny": true,
    "strictBindCallApply": true,
    "forceConsistentCasingInFileNames": true,
    "noFallthroughCasesInSwitch": true,
    "esModuleInterop": true,
    "resolveJsonModule": true
  },
  // `noUnusedLocals`/`noUnusedParameters` are deliberately ON. They were previously off, which is
    // why unused injections (businesses.controller) and unused imports accumulated unnoticed; the
    // lint script alone does not catch a dead constructor parameter.
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "include": ["src/**/*", "prisma/**/*", "scripts/**/*"],
    "exclude": ["node_modules", "dist"]
}
