{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": "./src",
    "incremental": false
  },
  // scripts/ is intentionally outside include: ad-hoc dev tooling must not be compiled into dist/
  // and shipped in the production image.
  "include": ["src/**/*"],
  "exclude": ["node_modules", "test", "dist", "scripts", "**/*spec.ts"]
}
