# Application
NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:3000

# Database
DATABASE_URL=postgresql://flyconnect:flyconnect@localhost:5432/flyconnect?schema=public

# Redis
REDIS_URL=redis://localhost:6379

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_REFRESH_SECRET=change-me-to-another-long-random-string
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Initial admin password used by `npm run seed`. Change it before seeding.
ADMIN_INITIAL_PASSWORD=

# WhatsApp Cloud API (values from a verified Meta WhatsApp Business Account)
# To go LIVE: fill WHATSAPP_ACCESS_TOKEN (permanent/system-user token) and
# WHATSAPP_PHONE_NUMBER_ID (WhatsApp Manager -> phone number -> Phone number ID),
# then set WHATSAPP_MOCK=false.
WHATSAPP_MOCK=true
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_META_APP_ID=
WHATSAPP_META_APP_SECRET=
WHATSAPP_WEBHOOK_APP_SECRET=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=flyconnect-verify-token
WHATSAPP_REGISTRATION_PIN=000000
WHATSAPP_API_VERSION=v21.0

# Exchange Rates (all free, no API key, no quota)
# Primary source updates hourly. Fallbacks are tried automatically if the primary
# fails, and the last good table is served flagged `stale` if every source is down.
CURRENCY_BASE=AED
CURRENCY_PRIMARY_URL=https://api.exchangerate.fun/latest?base=
CURRENCY_TTL_SECONDS=3300

# Monitoring
SENTRY_DSN=
