# Application
NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:3000
# Explicit deployment marker. main.ts trusts APP_ENV for its fail-closed security checks because
# NODE_ENV is frequently unset under pm2/systemd, which previously left them silently disabled.
APP_ENV=development

# Database
# POSTGRES_* are also read by docker-compose.yml (run it with --env-file backend/.env).
POSTGRES_USER=flyconnect
POSTGRES_PASSWORD=
POSTGRES_DB=flyconnect
DATABASE_URL=postgresql://flyconnect:CHANGE_ME@localhost:5432/flyconnect?schema=public

# Redis
# REDIS_PASSWORD is required by docker-compose.yml. Leave REDIS_URL empty if you are not
# using the compose stack.
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379

# Auth
# Generate with: openssl rand -base64 48
# These are intentionally blank. Do not paste a placeholder here: the boot guard in main.ts
# rejects known placeholder strings, and a placeholder long enough to pass a length-only check
# would sign every JWT in the fleet with a secret published in this repository.
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Initial admin password used by `npm run seed`. Change it before seeding.
ADMIN_INITIAL_PASSWORD=
# Public self-service signup creates an ADMIN in a brand new business. Keep false.
# Staff are created by an admin via POST /api/users.
ALLOW_PUBLIC_REGISTRATION=false

# WhatsApp Cloud API (values from a verified Meta WhatsApp Business Account)
# To go LIVE: fill WHATSAPP_ACCESS_TOKEN (permanent/system-user token) and
# WHATSAPP_PHONE_NUMBER_ID (WhatsApp Manager -> phone number -> Phone number ID),
# then set WHATSAPP_MOCK=false.
#
# WHATSAPP_WEBHOOK_VERIFY_TOKEN and WHATSAPP_WEBHOOK_APP_SECRET are mandatory in production:
# webhook signature verification fails closed without the app secret, and main.ts refuses to
# boot in production if either is missing. Generate the verify token yourself.
WHATSAPP_MOCK=true
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_META_APP_ID=
WHATSAPP_META_APP_SECRET=
WHATSAPP_WEBHOOK_APP_SECRET=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_REGISTRATION_PIN=
WHATSAPP_API_VERSION=v21.0

# Exchange Rates (all free, no API key, no quota)
# Primary source updates hourly. Fallbacks are tried automatically if the primary
# fails, and the last good table is served flagged `stale` if every source is down.
CURRENCY_BASE=AED
CURRENCY_PRIMARY_URL=https://api.exchangerate.fun/latest?base=
CURRENCY_TTL_SECONDS=3300

# Monitoring
SENTRY_DSN=

# ─────────────────────────────────────────────────────────────────────────────
# Google Drive backups - destination
# ─────────────────────────────────────────────────────────────────────────────
# FlyConnect backs up to Google Drive from the BACKEND. Never from a browser,
# and never a FlyConnect user's personal account: the credential lives here, on
# the server, and nothing about it is sent to any frontend.
#
# TWO POSSIBLE DESTINATIONS. Read this before choosing one.
#
# (a) A CONNECTED GOOGLE ACCOUNT  <- works on a free @gmail.com account
#     Set GOOGLE_DRIVE_CLIENT_ID/SECRET below, then use
#     Settings > Backups > "Connect Google Drive" once. The refresh token is
#     stored ENCRYPTED (see BACKUP_TOKEN_ENCRYPTION_KEY).
#
#     Trade-off, stated plainly: backups are tied to that one Google account.
#     If it is deleted, suspended, or the grant is revoked, backups stop. Use a
#     dedicated backups-only address if that matters.
#
# (b) A GOOGLE SERVICE ACCOUNT  <- unattended, but needs a Workspace Shared Drive
#     A service account has NO Drive storage quota of its own. Verified against
#     the live API:
#       POST /upload/drive/v3/files -> 403 "Service Accounts do not have
#       storage quota. Leverage shared drives, or use OAuth delegation."
#     It can still create file *metadata*, so a "can it create a file?" check
#     passes and the failure only appears when real bytes are uploaded. This
#     destination works only against a Shared Drive, which requires a paid
#     Google Workspace organisation.
#
# A connected account takes precedence over a configured service account,
# because on a personal install the service account cannot save anything.
# ─────────────────────────────────────────────────────────────────────────────

# (a) Connected Google account - OAuth web client.
# Create at: Google Cloud Console > APIs & Services > Credentials >
#             Create Credentials > OAuth client ID > Application type: Web app
#
# Authorized redirect URI (must match exactly):
#   http://localhost:4000/api/backups/destination/google/callback
# or, in production, whatever BACKEND_PUBLIC_URL points at. Set
# GOOGLE_DRIVE_REDIRECT_URI if the backend is mounted under a prefix.
#
# IMPORTANT: the consent screen MUST be set to publishing status "In production".
# While an app is in "Testing", Google expires refresh tokens after 7 days, and
# backups stop a week after connecting with no obvious cause.
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REDIRECT_URI=

# Encrypts the Drive refresh token at rest (AES-256-GCM).
# The token grants standing access to the whole Drive of the connected account,
# so a database leak would otherwise hand over that Google account. The API
# refuses to store a token without this set - it does not fall back to plaintext.
#
# Generate with:  openssl rand -base64 48
# Rotating this makes every stored token unreadable: the console will say so and
# ask for a reconnect. Archives already in Drive are untouched.
BACKUP_TOKEN_ENCRYPTION_KEY=

# (b) Google service account. Leave blank on a personal install - a connected
# account above is the supported path there.
#
# Provide the credential EITHER WAY, not both:
#
#   GOOGLE_SERVICE_ACCOUNT_JSON       the full service-account JSON, inline.
#                                    Newlines must be literal \n.
#   GOOGLE_SERVICE_ACCOUNT_KEY_PATH   absolute path to the .json key file on
#                                    disk. Prefer this in production: it keeps
#                                    the key out of environment dumps and process
#                                    listings.
#
# Never prefix either with NEXT_PUBLIC_, never put them in frontend env files,
# and never commit a key.
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SERVICE_ACCOUNT_KEY_PATH=

# Target Drive folder. Optional for a connected account: leave blank and FlyConnect
# finds or creates "FlyConnect Backups" in that account. Set it to pin a specific
# folder.
#
# For a service account the folder MUST be shared with the service account's
# client_email (IAM & Admin > Service Accounts) with Writer access. The
# drive.file scope can only see files the service account created, so an
# unshared folder produces FAILED BackupRun rows rather than a false success.
#
# Get the id from the folder URL: .../folders/<THIS_VALUE>
GOOGLE_DRIVE_FOLDER_ID=

# ─────────────────────────────────────────────────────────────────────────────
# Backup scheduler
# ─────────────────────────────────────────────────────────────────────────────
# Default false. Leave it false until a manual backup has been confirmed working
# end to end, otherwise an unattended nightly job is the first thing that ever
# exercises an unverified Drive setup.
# When enabled, requires a reachable Redis (REDIS_URL). BullMQ registers one
# repeatable job; re-registering replaces the existing repeatable key rather
# than adding a second, so restarts cannot double-schedule.
BACKUP_SCHEDULE_ENABLED=false

# How often the scheduled backup runs, in hours. Default 24.
#
# Note: the schedule is an INTERVAL, not a cron expression - the scheduler uses
# BullMQ's `upsertJobScheduler({ every })`. So `24` means "every 24 hours from
# when it was registered", not "at 02:00". If you need a fixed wall-clock time,
# drive backups from system cron instead: `BACKUP_CRON_HOURS` unset plus an
# external cron calling the backup endpoint.
BACKUP_CRON_HOURS=24

# Destructive restore gate.
# Default false. Keep false until restore has been verified end-to-end against a
# non-production PostgreSQL database and live Drive safety archive.
RESTORE_ENABLED=false