{
  "schema_version": "3",
  "name": "Appointment Booking Flow",
  "cart": {
    "enabled": true,
    "total_uses": 0,
    "items": []
  },
  "global_parameters": [
    {
      "name": "salonName",
      "value": "Aura Shine Salon & Wellness",
      "description": "Salon name shown in UI"
    },
    {
      "name": "branch",
      "value": "",
      "description": "Selected branch id"
    },
    {
      "name": "service",
      "value": "",
      "description": "Selected service id"
    },
    {
      "name": "staff",
      "value": "",
      "description": "Selected staff id (optional)"
    },
    {
      "name": "date",
      "value": "",
      "description": "Selected booking date YYYY-MM-DD"
    },
    {
      "name": "time",
      "value": "",
      "description": "Selected booking time HH:MM"
    },
    {
      "name": "customerName",
      "value": "",
      "description": "Customer name from WhatsApp profile"
    },
    {
      "name": "phone",
      "value": "",
      "description": "Customer phone (wa_id)"
    }
  ],
  "components": [
    {
      "type": "screen",
      "target": "components/screens/screen_select_branch.json",
      "id": "screen_select_branch"
    },
    {
      "type": "screen",
      "target": "components/screens/screen_select_service.json",
      "id": "screen_select_service"
    },
    {
      "type": "screen",
      "target": "components/screens/screen_select_staff.json",
      "id": "screen_select_staff",
      "visible": false
    },
    {
      "type": "screen",
      "target": "components/screens/screen_pick_date.json",
      "id": "screen_pick_date",
      "data": {
        "advanced": {
          "selectedDate": "global.date",
          "startDate": "global.currentDate",
          "minDate": "global.currentDate",
          "maxDate": "global.maxDate",
          "selectedTime": "global.time",
          "data": {
            "salonName": "global.salonName"
          }
        }
      }
    },
    {
      "type": "screen",
      "target": "components/screens/screen_confirm_booking.json",
      "id": "screen_confirm_booking"
    },
    {
      "type": "flow_terminator",
      "id": "appointment_created",
      "message": "Your appointment is confirmed ✅"
    },
    {
      "type": "flow_terminator",
      "id": "appointment_failed",
      "message": "Sorry, that slot could not be booked. Try again or contact us."
    }
  ],
  "sub_screens": {},
  "test_data": {},
  "test_parameters": {
    "salonName": "Aura Shine Salon & Wellness",
    "branch": "br-1",
    "service": "sr-12",
    "staff": "",
    "date": "2026-09-25",
    "time": "10:30",
    "customerName": "Priya",
    "phone": "919876543210"
  },
  "extension_parameters": {
    "branchList": [],
    "serviceList": [],
    "staffList": []
  },
  "app_extension": "https://your-salon-app.example.com/flows/appointment"
}