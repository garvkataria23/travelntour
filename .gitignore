node_modules
.next
.next-stale
out
.vercel
.env*
!.env.example
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.log
tsconfig.tsbuildinfo
.DS_Store
.vercel

# Backup credentials and artefacts. The real rclone.conf and the Google service
# account key decrypt every backup — they must never reach the repository.
# Only rclone.conf.example is tracked.
backup/rclone.conf
backup/sa.json
backup/*.dump
backup/*.dump.sha256
backup/*.partial
# Plain-text SQL dumps. These are produced by ad-hoc `pg_dump` runs rather than by
# backup.sh, which uses -Fc. They contain password hashes and customer PII, and a
# `.sql` extension is exactly what someone would forget is sensitive. `fc-pre-aed-*
# ` was caught in the act by this rule.
backup/*.sql
backup/*.sql.gz
backup/*.tar
backup/*.tar.gz
backup/*.tgz

# Electron build output. Regenerated by `npm run build` inside desktop/ and
# must never be committed: the installer alone is ~310 MB and the unpacked
# binary ~180 MB, both over GitHub's 100 MB hard limit.
desktop/build/
desktop/release/
desktop/*.blockmap

# Secrets, as belt-and-braces. The root pattern below catches any .env anywhere in
# the tree, which is what let META-WHATSAPP-API-KIT/.env exist alongside a tracked
# .env.example without anyone noticing the real one had been created.
.env
**/.env
!backend/.env.example
!**/.env.example

# Import from an unrelated project (Solastio). Nothing under backend/src imports it,
# and it shipped live Meta credentials into this repository's history in plain text.
# Tracked files are being untracked; this stops them coming back.
META-WHATSAPP-API-KIT/
