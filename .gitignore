node_modules
.next
.next-stale
out
.vercel
.env*
!.env.example
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.log
tsconfig.tsbuildinfo
.DS_Store
.vercel

# Backup credentials and artefacts. The real rclone.conf and the Google service
# account key decrypt every backup — they must never reach the repository.
# Only rclone.conf.example is tracked.
backup/rclone.conf
backup/sa.json
backup/*.dump
backup/*.dump.sha256
backup/*.partial

# Electron build output. Regenerated by `npm run build` inside desktop/ and
# must never be committed: the installer alone is ~310 MB and the unpacked
# binary ~180 MB, both over GitHub's 100 MB hard limit.
desktop/build/
desktop/release/
desktop/*.blockmap
